{
  "manifest_version": 3,
  "name": "Yak Club",
  "version": "1.0",

  "description": "Comment on any given website",

  "icons": {
    "48": "icons/logo-48.png"
  },
  "background": {
    "page": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "worker-src 'self' http://localhost:3000; script-src 'self' 'wasm-unsafe-eval'"
  }, 
  "permissions": [
    "webRequest",
    "unlimitedStorage",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "64": "icons/logo-64.png",
      "128": "icons/logo-128.png"
    }
  }
}